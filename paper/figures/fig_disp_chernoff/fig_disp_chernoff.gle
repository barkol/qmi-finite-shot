size 8.6 5.55
set font texcmr
set hei .34
set lwidth .02
amove 0 0.1
begin graph
  size 8.6 4.8
  scale auto
  nobox
  xaxis min 0 max 12 dticks 2 hei .34
  yaxis min 0 max 1 dticks 0.25 hei .34
  xtitle "\tex{displacement $|\alpha|$}" hei .34 dist .1
  ytitle "\tex{$\xi/\xi_{\mathrm{QC}}$}" hei .34 dist .1
  data "gle/a.dat" d1=c1,c2 d2=c1,c3 d3=c1,c4 d4=c1,c5
  data "gle/am.dat" d5=c1,c2 d6=c1,c3 d7=c1,c4 d8=c1,c5
  d1 line lstyle 1 lwidth .018 color rgb255(225,65,9)
  d2 line lstyle 2 lwidth .018 color rgb255(70,102,221)
  d3 line lstyle 1 lwidth .018 color rgb255(225,65,9)
  d4 line lstyle 2 lwidth .018 color rgb255(70,102,221)
  d5 marker fsquare msize .16 color rgb255(225,65,9)
  d6 marker wsquare msize .16 color rgb255(70,102,221)
  d7 marker ftriangle msize .16 color rgb255(225,65,9)
  d8 marker wtriangle msize .16 color rgb255(70,102,221)
end graph
set color rgb255(225,65,9)
amove 0.9 5.25
marker fsquare .5
set color black
set just lc
set hei .33
amove 1.15 5.25
write "\tex{het., $\bar n=0.5$}"
set color rgb255(225,65,9)
amove 3.45 5.25
marker ftriangle .5
set color black
set just lc
set hei .33
amove 3.7 5.25
write "\tex{$3$}"
set color rgb255(70,102,221)
amove 4.5 5.25
marker wsquare .5
set color black
set just lc
set hei .33
amove 4.75 5.25
write "\tex{hom., $\bar n=0.5$}"
set color rgb255(70,102,221)
amove 7.15 5.25
marker wtriangle .5
set color black
set just lc
set hei .33
amove 7.4 5.25
write "\tex{$3$}"
